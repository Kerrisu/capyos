# Copie este arquivo para ".env" e preencha com valores reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# Conteúdo INTEIRO do seu credenciais.json, em UMA LINHA SÓ (JSON válido).
# Dica: no terminal, você pode gerar essa linha com:
#   python -c "import json; print(json.dumps(json.load(open('credenciais.json'))))"
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Domínio(s) do frontend que podem chamar essa API, separados por vírgula.
# Em dev local, pode deixar em branco que o main.py já usa localhost:3000/5173
# como padrão. Em produção, preencha com o domínio real, ex:
# CORS_ALLOWED_ORIGINS=https://capyos.vercel.app
CORS_ALLOWED_ORIGINS=

# Connection string do banco Postgres (Neon). Copiada direto do painel do
# Neon, no formato: postgresql://usuario:senha@ep-xxxxx.neon.tech/neondb?sslmode=require
# Em dev local: cole a string real aqui no seu .env (nunca no .env.example).
# Em produção (Render): configure como variável de ambiente no painel do serviço.
DATABASE_URL=
